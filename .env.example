# Backend
SAPHIRE_DATABASE_URL=sqlite:///./data/saphire.db     # or postgresql+psycopg://user:pass@host:5432/saphire
SAPHIRE_API_KEY=dev-key
SAPHIRE_ARTIFACTS_DIR=./artifacts
SAPHIRE_INLINE_JOBS=0                                # 1 = run jobs inside the API process (no separate worker)
# LLM providers (LiteLLM) – only needed for non-mock agents / judges
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# SDK (agent-side)
SAPHIRE_HOST=http://localhost:8000
SAPHIRE_PROJECT=default
# Dashboard (build-time)
NEXT_PUBLIC_SAPHIRE_API=http://localhost:8000
